# Verified: Z7-LITE Rev1.1 schematic p5, p10, p11, p13 and MicroPhase Lab9.
set_property PACKAGE_PIN N18 [get_ports {clk_50m}]
set_property IOSTANDARD LVCMOS33 [get_ports {clk_50m}]
set_property PACKAGE_PIN P16 [get_ports {key_n[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {key_n[0]}]
set_property PACKAGE_PIN T12 [get_ports {key_n[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {key_n[1]}]
set_property PACKAGE_PIN Y17 [get_ports {adc_clk}]
set_property IOSTANDARD LVCMOS33 [get_ports {adc_clk}]
set_property PACKAGE_PIN T14 [get_ports {adc_otr}]
set_property IOSTANDARD LVCMOS33 [get_ports {adc_otr}]
set_property PACKAGE_PIN Y16 [get_ports {adc_data[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {adc_data[0]}]
set_property PACKAGE_PIN V18 [get_ports {adc_data[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {adc_data[1]}]
set_property PACKAGE_PIN V17 [get_ports {adc_data[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {adc_data[2]}]
set_property PACKAGE_PIN Y14 [get_ports {adc_data[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {adc_data[3]}]
set_property PACKAGE_PIN W14 [get_ports {adc_data[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {adc_data[4]}]
set_property PACKAGE_PIN W16 [get_ports {adc_data[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {adc_data[5]}]
set_property PACKAGE_PIN V16 [get_ports {adc_data[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {adc_data[6]}]
set_property PACKAGE_PIN R18 [get_ports {adc_data[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {adc_data[7]}]
set_property PACKAGE_PIN T17 [get_ports {adc_data[8]}]
set_property IOSTANDARD LVCMOS33 [get_ports {adc_data[8]}]
set_property PACKAGE_PIN W13 [get_ports {adc_data[9]}]
set_property IOSTANDARD LVCMOS33 [get_ports {adc_data[9]}]
set_property PACKAGE_PIN V12 [get_ports {adc_data[10]}]
set_property IOSTANDARD LVCMOS33 [get_ports {adc_data[10]}]
set_property PACKAGE_PIN T15 [get_ports {adc_data[11]}]
set_property IOSTANDARD LVCMOS33 [get_ports {adc_data[11]}]
set_property PACKAGE_PIN U18 [get_ports {hdmi_clk_p}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_clk_p}]
set_property PACKAGE_PIN U19 [get_ports {hdmi_clk_n}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_clk_n}]
set_property PACKAGE_PIN V20 [get_ports {hdmi_data_p[0]}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_data_p[0]}]
set_property PACKAGE_PIN W20 [get_ports {hdmi_data_n[0]}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_data_n[0]}]
set_property PACKAGE_PIN T20 [get_ports {hdmi_data_p[1]}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_data_p[1]}]
set_property PACKAGE_PIN U20 [get_ports {hdmi_data_n[1]}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_data_n[1]}]
set_property PACKAGE_PIN N20 [get_ports {hdmi_data_p[2]}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_data_p[2]}]
set_property PACKAGE_PIN P20 [get_ports {hdmi_data_n[2]}]
set_property IOSTANDARD TMDS_33 [get_ports {hdmi_data_n[2]}]
create_clock -name pl_clk50 -period 20.000 [get_ports clk_50m]
set_property SLEW FAST [get_ports adc_clk]
set_property DRIVE 8 [get_ports adc_clk]
set_property PULLUP TRUE [get_ports {key_n[*]}]
# The buttons are asynchronous inputs; only the first ASYNC_REG stage is excluded.
set_false_path -from [get_ports {key_n[*]}] -to [get_cells -hier -filter {NAME =~ */keys/meta_reg*}]
