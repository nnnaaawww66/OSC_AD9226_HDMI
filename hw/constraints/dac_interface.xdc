# DAC904 SBAS095C p5: rising latch, tSU >=1ns, tH >=1.5ns.
# Fixed 50MHz; data launches on the preceding falling edge. External allowance
# is provisional +/-1ns data-vs-clock flight time, to be measured on the module.
set_property PACKAGE_PIN D20 [get_ports dac_clk]
set_property IOSTANDARD LVCMOS33 [get_ports {dac_clk dac_data[*]}]
set_property DRIVE 8 [get_ports {dac_clk dac_data[*]}]
set_property SLEW SLOW [get_ports {dac_clk dac_data[*]}]
set_property PACKAGE_PIN G18 [get_ports {dac_data[0]}]
set_property PACKAGE_PIN G17 [get_ports {dac_data[1]}]
set_property PACKAGE_PIN B20 [get_ports {dac_data[2]}]
set_property PACKAGE_PIN C20 [get_ports {dac_data[3]}]
set_property PACKAGE_PIN J16 [get_ports {dac_data[4]}]
set_property PACKAGE_PIN K16 [get_ports {dac_data[5]}]
set_property PACKAGE_PIN H18 [get_ports {dac_data[6]}]
set_property PACKAGE_PIN J18 [get_ports {dac_data[7]}]
set_property PACKAGE_PIN G20 [get_ports {dac_data[8]}]
set_property PACKAGE_PIN G19 [get_ports {dac_data[9]}]
set_property PACKAGE_PIN H17 [get_ports {dac_data[10]}]
set_property PACKAGE_PIN H16 [get_ports {dac_data[11]}]
set_property PACKAGE_PIN D18 [get_ports {dac_data[12]}]
set_property PACKAGE_PIN E17 [get_ports {dac_data[13]}]
create_generated_clock -name dac_fwd -source [get_pins dac_forward/C] -divide_by 1 [get_ports dac_clk]
set_output_delay -clock dac_fwd -max 2.000 [get_ports {dac_data[*]}]
set_output_delay -clock dac_fwd -min -2.500 [get_ports {dac_data[*]}]
